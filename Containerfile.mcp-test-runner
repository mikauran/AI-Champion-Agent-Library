# syntax=docker/dockerfile:1
#
# Runner image for the MCP test platform (Phase 15). DEFINITION ONLY: building it is pending human.
# It holds Node, python3 and the dependencies of the in-container driver (src/lib/mcptest/driver.ts).
# The platform stages the repository sources, the package under test and the request at run time and
# execs the driver; nothing agent-specific or secret is baked in.
#
# Build:  podman build -t localhost/mcp-test-runner:latest -f Containerfile.mcp-test-runner .
#
# Everything is installed at BUILD time. The running container needs no network.

ARG NODE_VERSION=22.19-bookworm-slim

FROM node:${NODE_VERSION}

# The driver needs Node >= 22.19.
RUN node -e "const [a,b]=process.versions.node.split('.').map(Number); if(a<22||(a===22&&b<19)) process.exit(1)"

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Node dependencies under /node_modules: ESM resolution walks up from /work, so the staged sources find them.
# Versions equal the ones in package.json (a test compares them).
RUN npm install --prefix / --no-save --no-audit --no-fund --ignore-scripts \
      yaml@2.8.2 zod@4.3.6 fflate@0.8.3 tsx@4.21.0 \
    && npm cache clean --force

# Python dependencies of generated servers, in a venv (Debian marks the system Python as externally managed).
# UNVERIFIED: the fastmcp pin mirrors src/lib/mcpgen/emit/requirements.ts and has not been checked against
# the package index; the human decides the pin before the first build.
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir "fastmcp>=3.4,<4" "httpx>=0.27" pyyaml
ENV PATH=/opt/venv/bin:$PATH

# Non-root user (uid 1000 exists in the node image as "node").
RUN mkdir -p /work/in /work/out /work/pkg && chown -R node:node /work
USER node
WORKDIR /work

# The platform creates the container, stages files and execs the driver; no server starts by itself.
CMD ["sleep", "infinity"]
