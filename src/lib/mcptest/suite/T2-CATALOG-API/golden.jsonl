# Nine source-style checks (same ids as the implemented source case).
{"id":"tool_exists_lookup","type":"tool_exists","description":"A tool that fetches one item by identifier exists","tool_hint":"^lookup_item$","dimension":"D1"}
{"id":"lookup_by_id","type":"call","description":"Lookup the reference item by primary identifier","tool_hint":"^lookup_item$","args":{"id":"ACM-000042"},"expect":{"no_error":true,"field_value":{"id":"ACM-000042"}},"dimension":"D2"}
{"id":"lookup_by_code","type":"call","description":"Lookup the reference item by its alternate code","tool_hint":"^lookup_item$","args":{"code":"9900000000424"},"expect":{"no_error":true,"field_value":{"code":"9900000000424"}},"dimension":"D2"}
{"id":"search_keyword","type":"call","description":"Keyword search finds the reference item","tool_hint":"^search_items$","args":{"query":"Reference Bearing"},"expect":{"no_error":true,"field_present":"id"},"dimension":"D2"}
{"id":"search_empty","type":"call","description":"A query with no matches is explained, not a raw envelope","tool_hint":"^search_items$","args":{"query":"zzqxnomatchzz"},"expect":{"empty_with_message":true},"dimension":"D4"}
{"id":"bad_id","type":"call","description":"An unknown identifier yields a clean not-found","tool_hint":"^lookup_item$","args":{"id":"ACM-999999"},"expect":{"clean_not_found":true},"dimension":"D4"}
{"id":"supplier_filter","type":"call","description":"Filter by supplier returns items of that supplier","tool_hint":"supplier","args":{"supplier":"SUP-003"},"expect":{"no_error":true,"field_present":"supplier"},"dimension":"D2"}
{"id":"pagination_page2","type":"call","description":"Second page of a keyword search","tool_hint":"^search_items$","args":{"query":"acme","page":2,"per_page":5},"expect":{"no_error":true,"field_present":"id"},"dimension":"D4"}
{"id":"auth_failure","type":"auth","description":"A wrong key is reported as an authentication failure","tool_hint":"^search_items$","args":{"query":"acme"},"expect":{"status_category":"auth"},"dimension":"D4"}
# Extended behaviour pack: the ten generic checks, linked through check_kind.
{"id":"bh_lookup_by_id","type":"call","check_kind":"lookup_by_id","description":"Behaviour 1: primary identifier lookup","tool_hint":"^lookup_item$","args":{"id":"ACM-000042"},"dimension":"D2"}
{"id":"bh_lookup_by_alt_key","type":"call","check_kind":"lookup_by_alt_key","description":"Behaviour 2: alternate key lookup","tool_hint":"^lookup_item$","args":{"code":"9900000000424"},"dimension":"D2"}
{"id":"bh_partition_filter","type":"call","check_kind":"partition_filter","description":"Behaviour 3: every returned item belongs to the supplier","tool_hint":"supplier","args":{"supplier":"SUP-003"},"dimension":"D2"}
{"id":"bh_derived_filter","type":"call","check_kind":"derived_filter","description":"Behaviour 4: nested attribute filter, the native parameter is rejected by the upstream","tool_hint":"attribute","args":{"attribute":"Colour","value":"Red"},"dimension":"D2"}
{"id":"bh_projection","type":"call","check_kind":"projection","description":"Behaviour 5: items are projected to at most 12 top-level fields","tool_hint":"^search_items$","args":{"query":"ACM-000042"},"dimension":"D2"}
{"id":"bh_pagesize_clamp","type":"call","check_kind":"pagesize_clamp","description":"Behaviour 6: oversize page request is clamped or cleanly rejected","tool_hint":"^search_items$","args":{"query":"acme","per_page":"{{pageSize}}"},"dimension":"D4"}
{"id":"bh_pagination_ceiling","type":"call","check_kind":"pagination_ceiling","description":"Behaviour 7: a page beyond the result window does not leak the raw upstream error","tool_hint":"^search_items$","args":{"query":"acme","page":"{{page}}","per_page":50},"dimension":"D4"}
{"id":"bh_bad_input","type":"call","check_kind":"bad_input","description":"Behaviour 8: unknown identifier gives an explicit not-found signal","tool_hint":"^lookup_item$","args":{"id":"{{badId}}"},"dimension":"D4"}
{"id":"bh_empty_vs_error","type":"call","check_kind":"empty_vs_error","description":"Behaviour 9: empty result is explained","tool_hint":"^search_items$","args":{"query":"zzqxnomatchzz"},"dimension":"D4"}
{"id":"bh_auth_fail","type":"auth","check_kind":"auth_fail","description":"Behaviour 10: wrong key relaunch reports an auth failure","tool_hint":"^search_items$","args":{"query":"acme"},"dimension":"D4"}
{"id":"multilingual_fields","type":"call","description":"Names are returned in three languages","tool_hint":"^lookup_item$","args":{"id":"ACM-000042"},"expect":{"fields_present":["en","fi","sv"]},"dimension":"D2"}
