{
  "auth": {
    "envVar": "ACME_PARTS_API_KEY",
    "paramName": "X-Acme-Key",
    "scheme": "apiKeyHeader"
  },
  "backend": {
    "baseUrlEnv": "ACME_PARTS_BASE_URL",
    "kind": "http"
  },
  "entities": [
    {
      "fields": [
        {
          "description": "Stable part code",
          "identifier": true,
          "name": "partId",
          "type": "string"
        },
        {
          "description": "Display name",
          "name": "name",
          "nameLike": true,
          "type": "string"
        },
        {
          "classLike": true,
          "description": "Part group",
          "name": "category",
          "type": "string"
        },
        {
          "name": "price",
          "type": "number"
        },
        {
          "name": "inStock",
          "type": "boolean"
        },
        {
          "enum": [
            "active",
            "retired"
          ],
          "name": "status",
          "type": "string"
        },
        {
          "description": "Technical features as code and value entries",
          "name": "features",
          "type": "array"
        },
        {
          "name": "manufacturer",
          "type": "string"
        },
        {
          "name": "color",
          "type": "string"
        },
        {
          "name": "material",
          "type": "string"
        },
        {
          "name": "weightKg",
          "type": "number"
        },
        {
          "name": "lengthMm",
          "type": "number"
        },
        {
          "name": "widthMm",
          "type": "number"
        },
        {
          "name": "heightMm",
          "type": "number"
        },
        {
          "name": "warrantyMonths",
          "type": "integer"
        },
        {
          "name": "shelfLife",
          "type": "integer"
        },
        {
          "name": "packSize",
          "type": "integer"
        },
        {
          "name": "barcode",
          "type": "string"
        },
        {
          "name": "origin",
          "type": "string"
        },
        {
          "name": "notes",
          "type": "string"
        },
        {
          "name": "createdOn",
          "type": "string"
        },
        {
          "name": "updatedOn",
          "type": "string"
        },
        {
          "name": "supplierRef",
          "type": "string"
        },
        {
          "name": "leadTimeDays",
          "type": "integer"
        },
        {
          "name": "currency",
          "type": "string"
        }
      ],
      "id": "part",
      "identifierFields": [
        "partId"
      ],
      "label": "Part",
      "nested": [
        {
          "field": "features",
          "itemFields": [
            {
              "classLike": true,
              "name": "featureCode",
              "type": "string"
            },
            {
              "name": "featureValue",
              "type": "string"
            },
            {
              "name": "unit",
              "type": "string"
            }
          ],
          "keyFields": [
            "featureCode"
          ],
          "valueFields": [
            "featureValue",
            "unit"
          ]
        }
      ]
    }
  ],
  "gaps": [],
  "limits": {
    "maxPageSize": 50,
    "maxResponseItems": 200
  },
  "name": "Acme Parts API",
  "operations": [
    {
      "entity": "part",
      "id": "getPart",
      "kind": "get",
      "method": "GET",
      "params": [
        {
          "description": "Part code",
          "in": "path",
          "name": "partId",
          "required": true,
          "type": "string"
        }
      ],
      "path": "/parts/{partId}",
      "summary": "Fetch one part"
    },
    {
      "entity": "part",
      "id": "listParts",
      "kind": "search",
      "method": "GET",
      "pageParam": "page",
      "pageSizeParam": "size",
      "params": [
        {
          "description": "Free text query",
          "in": "query",
          "name": "q",
          "required": false,
          "type": "string"
        },
        {
          "in": "query",
          "min": 1,
          "name": "page",
          "required": false,
          "type": "integer"
        },
        {
          "in": "query",
          "max": 50,
          "min": 1,
          "name": "size",
          "required": false,
          "type": "integer"
        }
      ],
      "path": "/parts",
      "summary": "Search and list parts"
    }
  ],
  "writeOperationsDropped": [
    "createPart",
    "deletePart"
  ]
}
