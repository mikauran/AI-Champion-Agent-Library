+def _sel(ctx, path):
+    """Walk dictionaries and lists along a fixed path. Missing anything gives None. No attribute access."""
+    current = ctx
+    for part in path:
+        if isinstance(part, int):
+            if isinstance(current, list) and -len(current) <= part < len(current):
+                current = current[part]
