# Authentication is enabled by default. Set to false to allow access without signing in.
AUTH_ENABLED=true

# Exact, comma-separated email addresses allowed to sign in.
AUTH_ALLOWED_EMAILS=jussi@example.org,mikko@example.org

# Optional comma-separated email domains whose addresses are allowed to sign in.
# AUTH_ALLOWED_EMAIL_DOMAINS=example.org,partner.example.org

# Brevo is the default email transport. BREVO_API_KEY is not needed when SMTP_SERVER is set.
BREVO_API_KEY=replace-with-your-brevo-api-key
AUTH_EMAIL_FROM=agent-library@example.org
AUTH_EMAIL_FROM_NAME=AIC Agent Library

# Optional unauthenticated SMTP relay over plain TCP (default port: 25).
# When SMTP_SERVER has a value, it is used instead of Brevo.
# SMTP_SERVER=mail.internal.example.org
# SMTP_PORT=25

# OpenAI credential used by the runnable Try it out demo backend.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Public base URL used by SvelteKit's CSRF origin check.
ORIGIN=http://localhost:3000

# Use false for local http://localhost development and true behind HTTPS.
AUTH_COOKIE_SECURE=false

# --- Container-backed Try it out (Phase 8) ---------------------------------
# Pi runs in per-session containers started through the host user's Podman socket.
# Defaults are shown commented; uncomment to override.

# Set to false to disable the container runner (direct model call only).
# PI_RUNNER_ENABLED=true
# Image built from Containerfile.pi-runner.
# PI_RUNNER_IMAGE=localhost/pi-runner:latest
# Compose requires the host deployment user's XDG_RUNTIME_DIR (normally set by login).
# If missing, export XDG_RUNTIME_DIR="/run/user/$(id -u)" in the host shell,
# then run systemctl --user enable --now podman.socket as that same user.
# PI_RUNNER_SOCKET below is for running the app outside Compose; Compose pins
# the container path to /run/podman/podman.sock and mounts the host socket there.
# Podman socket path (default: $XDG_RUNTIME_DIR/podman/podman.sock, or /run/podman/podman.sock).
# PI_RUNNER_SOCKET=/run/podman/podman.sock
# Network Pi containers join; must be internal (no external egress).
# PI_RUNNER_NETWORK=aic-pi-internal
# Local development ONLY: allow a non-internal network (open egress). Never in production
# (podman-compose pins this to false).
# PI_RUNNER_ALLOW_OPEN_EGRESS=false
# URL Pi containers use to reach the app's LLM proxy (local dev only; podman-compose pins its own).
# PI_LLM_PROXY_URL=http://aic-agent-library:3000/api/llm/v1
# Upstream the LLM proxy forwards to.
# PI_LLM_UPSTREAM_URL=https://api.openai.com/v1
# Maximum concurrent Pi containers.
# PI_RUNNER_MAX_CONTAINERS=5
# New anonymous sessions one client address may start per 10 minutes (AUTH_ENABLED=false); 0 = unlimited.
# PI_RUNNER_ANON_SESSIONS_PER_CLIENT=5
# Idle time before a warm container is removed (ms).
# PI_RUNNER_IDLE_TTL_MS=300000
# Minimum idle time before a container may be evicted for capacity (ms).
# PI_RUNNER_MIN_IDLE_MS=60000
# How long a job waits for a warming container (ms).
# PI_RUNNER_WARM_WAIT_MS=90000
# Hard timeout for one Pi job (ms).
# PI_RUNNER_JOB_TIMEOUT_MS=300000
# Container limits: memory (MB), CPUs, process count.
# PI_RUNNER_MEMORY_MB=1024
# PI_RUNNER_CPUS=0.5
# PI_RUNNER_PIDS=200
# tmpfs sizes (MB) for /work, /tmp and the Pi agent dir.
# PI_RUNNER_WORK_TMPFS_MB=256
# PI_RUNNER_TMP_TMPFS_MB=64
# PI_RUNNER_AGENT_TMPFS_MB=16
# File staging mode: tmpfs (read-only root) or layer (writable container layer). See smoke script.
# PI_RUNNER_FS_MODE=tmpfs
# Comma-separated Pi tools enabled (read,write,edit,bash,grep,find,ls).
# PI_RUNNER_TOOLS=read,write,edit,grep,find,ls
# Fall back to the direct model call when the engine is unreachable or a container fails to start.
# PI_FALLBACK_ENABLED=true
# Per-job LLM budgets enforced by the proxy.
# PI_JOB_TOKEN_BUDGET=100000
# PI_JOB_REQUEST_BUDGET=40
# Output zip limits.
# PI_RUNNER_MAX_OUTPUT_BYTES=20971520
# PI_RUNNER_MAX_OUTPUT_FILES=200

# Diagnostic: expose per-job token counts at /api/tryitout/jobs/:id/usage (off by default).
# TRYITOUT_USAGE_ENDPOINT=1
